# Copier vers .env (jamais commité) et compléter.
APP_NAME=PAI
ENVIRONMENT=development            # development | production | test
BASE_URL=http://localhost:8000

# Base : PostgreSQL 16 en production (docker compose), SQLite accepté en local.
DB_URL=sqlite:///./data/pai.db
# DB_URL=postgresql+psycopg://pai:CHANGE_ME@pai_db:5432/pai
POSTGRES_PASSWORD=CHANGE_ME

# Fournisseur IA : claude | openai | local | null (mode dégradé, sans IA)
PAI_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=
PAI_AI_CACHE=on                    # on | off | replay_only

# Sécurité (générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
FILE_URL_TTL_SECONDS=300
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# Garde-fous de coût (euros)
COST_CAP_EUR_PER_PACK=0.80
COST_CAP_EUR_PER_DAY=6.00

# Rendu PDF : laisser vide pour le Chromium de Playwright
CHROMIUM_EXECUTABLE=

# Mot de passe de l'interface : créé par `python -m pai create-user` (haché argon2, jamais en clair ici)
