# Copier vers .env (jamais commité : .gitignore) et compléter. `chmod 600 .env`.
APP_NAME=PAI
ENVIRONMENT=development            # development | production | test (docker compose force production)
BASE_URL=http://localhost:8000     # production : https://pai.votre-domaine.fr (nom d'hôte stable du tunnel ou de Caddy)

# ── Base de données ──────────────────────────────────────────────────────────
# Local : SQLite. Docker : DB_URL est construit par docker-compose.yml à partir de PAI_DB_PASSWORD.
DB_URL=sqlite:///./data/pai.db
PAI_DB_PASSWORD=CHANGE_ME          # python -c "import secrets; print(secrets.token_urlsafe(24))"

# ── IA : GRATUITE PAR DÉFAUT. PAI fonctionne entièrement SANS IA ; l'IA locale (Ollama) améliore la rédaction. ──
# AI_PROVIDER : local (défaut : Ollama si joignable, sinon sans IA) | none (jamais d'IA) | anthropic | openai_compatible
#               (et gemini | mistral). Un fournisseur externe est OPTIONNEL et payant : il faut sa clé.
# Les réglages faits dans l'interface (Réglages → IA : fournisseur actif, clés chiffrées en base) priment sur ceux-ci.
AI_PROVIDER=local
AI_PROFILE=balanced                # eco (le moins d'appels) | balanced | quality (routeur par tâche : config/models.yaml)
AI_MODEL=                          # vide = choix mesuré sur la machine (python -m pai ai setup)
AI_MODEL_SMALL=                    # petit modèle local (extraction, classement) ; vide = choix mesuré
AI_BASE_URL=                       # openai_compatible : URL de l'API ; local : URL d'Ollama si différente
AI_API_KEY=                        # clé du fournisseur externe choisi (jamais commitée)
OLLAMA_BASE_URL=http://localhost:11434   # hors Docker ; en Docker, PAI_OLLAMA_URL (plus bas) s'applique
PAI_SEMANTIC_EMBEDDINGS=0          # 1 = rapprochements sémantiques par embeddings locaux (jamais une preuve)
# Variables historiques, toujours lues (AI_* prime) :
PAI_AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
OPENAI_API_KEY=
OPENAI_MODEL=
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=
PAI_AI_CACHE=on                    # on | off | replay_only

# ── Sécurité ─────────────────────────────────────────────────────────────────
# SECRET_KEY chiffre aussi les clés d'API saisies dans l'interface (Réglages → IA) : la changer oblige à les ressaisir.
SECRET_KEY=                        # python -m pai secret  (obligatoire en production)
COOKIE_SECURE=true                 # laisser true : HTTPS (Caddy / Tailscale) ou http://localhost
SESSION_TTL_HOURS=12
FILE_URL_TTL_SECONDS=300
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# ── Garde-fous de coût (euros) ───────────────────────────────────────────────
COST_CAP_EUR_PER_PACK=0.80
COST_CAP_EUR_PER_DAY=6.00

# ── Rendu PDF : vide = Chromium de Playwright (inclus dans l'image Docker) ───
CHROMIUM_EXECUTABLE=

# ── Déploiement Docker ───────────────────────────────────────────────────────
PAI_HTTP_PORT=8080                 # écoute sur 127.0.0.1 uniquement (Tailscale serve / tunnel SSH / Caddy)
PAI_VERSION=latest
# Profils actifs (repris par `docker compose up` et deploy/update.sh), séparés par des virgules :
#   cloudflare (accès public recommandé) | caddy (alternative : ports 80/443 ouverts) | ai-local (Ollama)
COMPOSE_PROFILES=
# Accès public : cloudflare | caddy | tailscale (affiché dans « État du système » ; cloudflare = l'IP du client
# est lue dans CF-Connecting-IP, posé par Cloudflare : ne pas l'activer avec Caddy)
PAI_ACCESS=
# Profil cloudflare : jeton du tunnel NOMMÉ (Cloudflare Zero Trust → Networks → Tunnels → votre tunnel → jeton).
# Nom d'hôte public stable choisi dans Cloudflare (ex. pai.votre-domaine.fr) → service http://pai_web:8000.
CLOUDFLARE_TUNNEL_TOKEN=
# Profil caddy : pai.votre-domaine.fr (DNS A → IP du serveur)
PAI_DOMAIN=
# Profil ai-local : URL d'Ollama vue depuis les conteneurs (défaut http://pai_ollama:11434)
PAI_OLLAMA_URL=

# ── Sauvegardes chiffrées (deploy/backup.sh, deploy/restore.sh) ──────────────
PAI_BACKUP_DIR=./backups
PAI_BACKUP_KEEP=14                 # nombre de sauvegardes conservées (rotation)
PAI_BACKUP_AGE_RECIPIENT=          # clé publique age (age1…) ; la clé privée reste HORS du serveur
# PAI_BACKUP_AGE_IDENTITY=/chemin/vers/cle-privee.txt   # uniquement pour restaurer

# Mot de passe de l'interface : `python -m pai create-user NOM` (haché argon2, jamais en clair ici).
