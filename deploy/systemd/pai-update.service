# PAI — mise à jour automatique : ne fait rien si le code n'a pas changé ; sinon sauvegarde, reconstruit,
# teste et revient en arrière en cas d'échec (deploy/update.sh). Installation : docs/DEPLOIEMENT_AUTO.md.
[Unit]
Description=PAI : mise à jour si la branche suivie a changé
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=PAI_USER
WorkingDirectory=PAI_DIR
Environment=PAI_UPDATE_IF_CHANGED=1
ExecStart=PAI_DIR/deploy/update.sh
Nice=10
